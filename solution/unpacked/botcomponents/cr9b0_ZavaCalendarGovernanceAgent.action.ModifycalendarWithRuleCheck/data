kind: TaskDialog
inputs:
  - kind: AutomaticTaskInput
    propertyName: text
    description: The exact eventId from the new meeting request. Pass only that ID.
modelDisplayName: Check and move meeting
modelDescription: Use this flow once for the NEW meeting ID. It reads the actual calendar and active rules, protects board meetings with fixed checks, finds a free time within two business days, preserves duration, verifies any change, and emails the assistant only if a confirmed conflict remains unresolved. Do not choose another meeting ID or supply a proposed time. Return its actual result. It is the only calendar change path.
outputs:
  - propertyName: result
  - propertyName: status
  - propertyName: movedCount
  - propertyName: needsHelp
  - propertyName: notificationSent
action:
  kind: InvokeFlowTaskAction
  flowId: 80614549-fdbc-f111-aaad-6045bd067e6d
  connectionProperties:
    $kind: ConnectionProperties
    diagnostics: null
    mode: Invoker
outputMode: All
